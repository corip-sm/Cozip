<Window x:Class="Cozip.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cozip"
        Width="1320"
        Height="860"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource ChromeBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Cozip"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Familiar archive manager shell over the native Cozip engine"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right"
                        Background="#ECFDF5"
                        BorderBrush="#A7F3D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Backend"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="BackendStatusTextBlock"
                                   Margin="8,0,0,0"
                                   Text="cozip_cli.exe" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource ChromeBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="CreateZipButton"
                            Content="New ZIP"
                            Click="CreateZipButton_OnClick" />
                    <Button x:Name="OpenArchiveButton"
                            Content="Open Archive"
                            Click="OpenArchiveButton_OnClick" />
                    <Button x:Name="ExtractButton"
                            Content="Extract"
                            Click="ExtractButton_OnClick" />
                    <Button x:Name="TestButton"
                            Content="Test"
                            Click="TestButton_OnClick" />
                    <Button x:Name="RefreshButton"
                            Content="Refresh"
                            Click="RefreshButton_OnClick" />
                </StackPanel>
                <TextBlock x:Name="CurrentArchiveTextBlock"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="No archive opened" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource ChromeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Quick Tasks"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Bandizip-style daily flow, but wired to the Cozip backend."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,6,0,14"
                                   TextWrapping="Wrap" />
                        <Button Content="Open ZIP"
                                Click="OpenArchiveButton_OnClick" />
                        <Button Content="Create ZIP From Files"
                                Click="CreateZipButton_OnClick" />
                        <Button Content="Extract Current Archive"
                                Click="ExtractButton_OnClick" />
                        <Button Content="Verify Current Archive"
                                Click="TestButton_OnClick" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource ChromeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Archive Summary"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Path"
                                   Margin="0,14,0,2"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="SummaryPathTextBlock"
                                   Text="-"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Entries"
                                   Margin="0,14,0,2"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="SummaryEntriesTextBlock"
                                   Text="0" />
                        <TextBlock Text="Total Size"
                                   Margin="0,14,0,2"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="SummarySizeTextBlock"
                                   Text="0 B" />
                        <TextBlock Text="Last Action"
                                   Margin="0,14,0,2"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="SummaryActionTextBlock"
                                   Text="Idle"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource ChromeBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="16,16,16,10">
                        <TextBlock Text="Archive Entries"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left" />
                        <TextBlock x:Name="EntryCountTextBlock"
                                   Text="0 items"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <ListView Grid.Row="1"
                              x:Name="EntriesListView"
                              Margin="16,0,16,16"
                              BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Type" Width="70" DisplayMemberBinding="{Binding Kind}" />
                                <GridViewColumn Header="Name" Width="420" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Method" Width="120" DisplayMemberBinding="{Binding Method}" />
                                <GridViewColumn Header="Size" Width="120" DisplayMemberBinding="{Binding SizeDisplay}" />
                                <GridViewColumn Header="Packed" Width="120" DisplayMemberBinding="{Binding PackedDisplay}" />
                                <GridViewColumn Header="CRC32" Width="120" DisplayMemberBinding="{Binding Crc32}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource ChromeBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,12,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Operation Log"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBox x:Name="LogTextBox"
                         Grid.Row="1"
                         Margin="0,12,0,0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         Background="#0F172A"
                         Foreground="#E2E8F0"
                         BorderThickness="0"
                         Padding="12" />
            </Grid>
        </Border>

        <StatusBar Grid.Row="4"
                   Background="{StaticResource PanelBackgroundBrush}"
                   BorderBrush="{StaticResource ChromeBrush}"
                   BorderThickness="1">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock"
                           Text="Ready" />
            </StatusBarItem>
            <StatusBarItem>
                <Separator Width="1" Height="18" />
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar x:Name="OperationProgressBar"
                             Width="220"
                             Height="14"
                             Minimum="0"
                             Maximum="100"
                             Visibility="Collapsed"
                             IsIndeterminate="True" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="OperationStateTextBlock"
                           Text="Idle"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="ElapsedTextBlock"
                           Text="0 ms"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
